# dependencies
node_modules/

# build output
dist/
build/
coverage/
*.tsbuildinfo
.vite/

# env — never commit real secrets (R10)
.env
.env.*
!.env.example

# local database files (sqlite)
*.db
*.db-journal
*.db-wal
*.db-shm
# a test database must never live here; global-setup puts it in the OS temp directory
backend/prisma/test.db*

# local uploads (StorageDriver=local)
backend/storage/uploads/*
!backend/storage/uploads/.gitkeep

# logs
*.log
npm-debug.log*

# editors / OS
.DS_Store
Thumbs.db
.idea/
.vscode/*
!.vscode/extensions.json
