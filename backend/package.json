{
  "name": "@clearwood/backend",
  "version": "0.1.0",
  "private": true,
  "description": "ClearWood Furnitures REST API (Express 4 + TypeScript + Prisma)",
  "license": "UNLICENSED",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.build.json && node scripts/rewrite-shared-imports.cjs",
    "start": "node dist/server.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "check:production": "tsx scripts/check-production.ts",
    "preflight": "tsx scripts/preflight.ts",
    "test:watch": "vitest",
    "db:generate": "node scripts/sync-prisma-provider.cjs && prisma generate",
    "db:migrate": "node scripts/sync-prisma-provider.cjs && prisma migrate dev",
    "db:deploy": "node scripts/sync-prisma-provider.cjs && prisma migrate deploy",
    "db:seed": "prisma db seed",
    "db:studio": "prisma studio",
    "db:reset": "node scripts/sync-prisma-provider.cjs && prisma migrate reset --force",
    "admin:reset-password": "tsx scripts/reset-admin-password.ts",
    "postinstall": "node scripts/ensure-env.cjs && node scripts/sync-prisma-provider.cjs && prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^7.3.0",
    "@aws-sdk/client-s3": "^3.1135.0",
    "@aws-sdk/lib-storage": "^3.1135.0",
    "@aws-sdk/s3-request-presigner": "^3.1135.0",
    "@clearwood/shared": "*",
    "@prisma/client": "^6.1.0",
    "argon2": "^0.41.1",
    "blurhash": "^2.0.5",
    "compression": "^1.7.5",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "csv-parse": "^5.6.0",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "hpp": "^0.2.3",
    "jsonwebtoken": "^9.0.3",
    "markdown-it": "^15.0.2",
    "multer": "^1.4.5-lts.2",
    "pdfkit": "^0.20.2",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "sanitize-html": "^2.17.7",
    "sharp": "^0.33.5",
    "swagger-ui-express": "^5.0.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/compression": "^1.7.5",
    "@types/cookie-parser": "^1.4.8",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/hpp": "^0.2.6",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/markdown-it": "^14.2.0",
    "@types/multer": "^1.4.13",
    "@types/node": "^22.10.2",
    "@types/pdfkit": "^0.17.6",
    "@types/sanitize-html": "^2.16.1",
    "@types/supertest": "^6.0.2",
    "@types/swagger-ui-express": "^4.1.7",
    "mysql2": "^3.24.4",
    "pino-pretty": "^13.0.0",
    "prisma": "^6.1.0",
    "supertest": "^7.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
