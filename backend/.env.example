# ClearWood Furnitures — backend environment
#
# Copy to `.env` and fill in. NEVER commit `.env`; it is gitignored and always has been.
#
# THIS FILE IS NOT ONLY DOCUMENTATION. `src/config/productionSecrets.ts` DERIVES the list of
# forbidden production placeholders from the values below, so production refuses to boot while a
# secret still equals what is written here. Changing a placeholder therefore changes what
# production rejects. `tests/env-example.test.ts` asserts this file and the Zod schema in
# `src/config/env.ts` still list the same keys.
#
# HOW TO READ THE GROUPS:
#   [BOOT]   the process will not start correctly without a real value in production
#   [DRIVER] required only when the matching *_DRIVER is selected
#   [TUNE]   safe to leave at the default
#
# Generate every [BOOT] secret straight into the file, never by hand:
#   openssl rand -base64 48
#
# DATABASE TARGETS (PROJECT_CONTEXT §40): the APPLICATION always talks to MySQL on its own host.
# It must NEVER use the SSH tunnel — 79 queries at 67 ms is a five-second page. The tunnel is for
# `prisma migrate deploy` and seeding, passed on the command line for that one command.
# --- application -----------------------------------------------------------
# [BOOT] `production` also switches on the placeholder-secret refusal above.
NODE_ENV=development
APP_NAME=ClearWood Furnitures
# [BOOT] Bind port. Behind a reverse proxy the app listens on 127.0.0.1 only.
API_PORT=7180
# [BOOT] Bind address. Loopback unless you deliberately need another interface (0.0.0.0 exposes the
# API to every network this machine is on - never do that without TLS and a proxy in front).
HOST=127.0.0.1
# [BOOT behind a proxy] Which proxies may set X-Forwarded-For. Rate limits and the audit log use the
# resulting client IP. false = nobody (the app is reached directly). nginx on this machine =
# loopback. Also accepted, comma-separated: linklocal, uniquelocal, IPs, CIDRs. `true`, `*`, hop
# counts and /0 ranges are refused: they let any client choose its own IP.
TRUST_PROXY=false
API_PREFIX=/api/v1
# [BOOT in production] Exact origins, no trailing slash. CORS_ORIGINS is comma-separated.
WEB_ORIGIN=http://localhost:7181
ADMIN_ORIGIN=http://localhost:7182
CORS_ORIGINS=http://localhost:7181,http://localhost:7182
# --- database (D1) ---------------------------------------------------------
# THREE TARGETS, and only one of them belongs here at a time (PROJECT_CONTEXT Â§40):
#   laptop dev and tests -> local MySQL 8 on 127.0.0.1:3306        (0.41 ms)
#   the app in production -> MySQL on the VPS, from the VPS        (sub-ms)
#   laptop admin work     -> the VPS through an SSH tunnel on 3307 (67 ms)
#
# The APPLICATION must never run over the tunnel: 79 queries at 67 ms is a five-second page.
# The tunnel is for `prisma migrate deploy` and seeding, passed on the command line.
#
# The test suite refuses any target that is not 127.0.0.1:3306 or localhost:3306, and refuses
# the database named clearwood_prod outright. Widen it deliberately with:
#   CLEARWOOD_TEST_ALLOWED_HOSTS=host:port[,host:port]
# or point the suite somewhere else entirely with CLEARWOOD_TEST_DATABASE_URL.
DATABASE_PROVIDER=mysql
DATABASE_URL="mysql://user:password@127.0.0.1:3306/clearwood_db"
# Pre-created and empty. `migrate dev` needs it because the app user cannot create databases.
SHADOW_DATABASE_URL="mysql://user:password@127.0.0.1:3306/clearwood_shadow"

# --- cache -----------------------------------------------------------------
# memory = one process only. Under the PM2 cluster every worker would keep its own cache and its
# own rate-limit counters, so production runs CACHE_DRIVER=redis (infra/README.md). Redis is an
# optimisation, never a dependency: when it is down, reads come from MySQL and rate limits count
# per process until it returns.
CACHE_DRIVER=memory
# [DRIVER] redis:// or rediss://, password included - it is never logged.
#   e.g. redis://:<password>@127.0.0.1:6380/0
REDIS_URL=
# [TUNE] Every key starts with this, so one Redis can serve several apps or environments.
REDIS_KEY_PREFIX=cw:
# [TUNE] Past these a request stops waiting for Redis and is served from MySQL.
REDIS_CONNECT_TIMEOUT_MS=2000
REDIS_COMMAND_TIMEOUT_MS=500
# [TUNE] A larger value is simply not cached (either driver).
CACHE_MAX_VALUE_BYTES=1048576
# The Redis integration tests run only when CLEARWOOD_TEST_REDIS_URL is set in the shell (localhost
# only), e.g. CLEARWOOD_TEST_REDIS_URL=redis://127.0.0.1:6380 - never point it at a shared Redis.

# --- auth (used from Prompt 3) --------------------------------------------
# Customer realm (storefront)
JWT_ACCESS_SECRET=dev_access_secret_change_me
JWT_REFRESH_SECRET=dev_refresh_secret_change_me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=30d
COOKIE_DOMAIN=localhost
CUSTOMER_ACCESS_TOKEN_TTL=15m
CUSTOMER_REFRESH_TOKEN_TTL=30d

# Admin realm â€” separate secrets and audience so an admin token can never sign a storefront request
ADMIN_JWT_ACCESS_SECRET=dev_admin_access_secret_change_me
ADMIN_JWT_REFRESH_SECRET=dev_admin_refresh_secret_change_me
ADMIN_ACCESS_TOKEN_TTL=15m
ADMIN_REFRESH_TOKEN_TTL=7d
ADMIN_COOKIE_DOMAIN=localhost

# Cookies & CSRF. AUTH_COOKIE_SECURE must be true in production (startup refuses otherwise).
AUTH_COOKIE_SECURE=false
AUTH_COOKIE_SAMESITE=lax
CSRF_ENABLED=true

# Password policy & progressive lockout
PASSWORD_MIN_LENGTH=10
LOGIN_MAX_ATTEMPTS=5
LOGIN_LOCK_MINUTES=15
AUTH_RATE_LIMIT_MAX=10
AUTH_RATE_LIMIT_WINDOW_MS=60000

# OTP. Required only when OTP_DRIVER is sms/whatsapp.
OTP_DRIVER=log
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_RESEND_COOLDOWN_SECONDS=45
OTP_MAX_PER_HOUR=5
OTP_MAX_ATTEMPTS=5
SMS_API_KEY=
SMS_SENDER_ID=

# Bootstrap admin, created by the seed with the ordinary ADMIN role (NOT SUPER_ADMIN) and
# mustChangePassword=true: every admin route except the self-service ones answers 403
# PASSWORD_CHANGE_REQUIRED until it is changed. Keyed on the email - re-seeding never touches an
# existing account. The password is never logged. [BOOT in production] both must be real values.
# To reset an existing account: npm run admin:reset-password [-- --email someone@example.com]
ADMIN_SEED_EMAIL=admin@clearwood.local
ADMIN_SEED_PASSWORD=ChangeMe@12345
ADMIN_SEED_NAME=Platform Owner

# --- storage (used from Prompt 4) -----------------------------------------
STORAGE_DRIVER=local
LOCAL_UPLOAD_DIR=./storage/uploads
PUBLIC_MEDIA_BASE_URL=http://localhost:7180/media
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PUBLIC_BASE_URL=
S3_ENDPOINT=
S3_FORCE_PATH_STYLE=false
S3_ACL=private
S3_UPLOAD_PREFIX=

# --- media pipeline (Prompt 4) --------------------------------------------
MAX_UPLOAD_SIZE_MB=15
MAX_UPLOAD_FILES=20
MAX_IMAGE_DIMENSION=4000
ALLOWED_IMAGE_MIME=image/jpeg,image/png,image/webp,image/avif,image/gif,image/svg+xml
ALLOWED_VIDEO_MIME=video/mp4,video/webm
ALLOWED_DOC_MIME=application/pdf
IMAGE_QUALITY=82
ENABLE_AVIF=false
GENERATE_BLURHASH=true
MEDIA_SIGNED_URL_TTL=900
# MUST be replaced in production â€” the app refuses to boot with this default.
MEDIA_SIGNING_SECRET=dev-media-signing-secret-change-me
MEDIA_CDN_BASE_URL=

# --- admin catalog (Prompt 5) ---------------------------------------------
VARIANT_MATRIX_MAX=200
IMPORT_MAX_ROWS=20000
IMPORT_CHUNK_SIZE=100
EXPORT_MAX_ROWS=50000
CATALOG_CACHE_TTL_SECONDS=300
ADMIN_LIST_DEFAULT_LIMIT=25
IDEMPOTENCY_TTL_HOURS=24

# --- pricing engine (Prompt 6) --------------------------------------------
PRICING_CACHE_TTL_SECONDS=120
PRICING_MAX_QUOTE_ITEMS=50
COUPON_CODE_LENGTH=10
# Bump whenever the calculation rules change; stored with every order snapshot.
# 2: the customer group's discountBp is applied (engine step 6).
PRICING_ENGINE_VERSION=2

# --- storefront search (Prompt 7) -----------------------------------------
# `sql` works on SQLite today and MySQL 8 later; `meili` is a documented stub.
SEARCH_DRIVER=sql
SEARCH_MIN_QUERY_LENGTH=2
SEARCH_MAX_RESULTS=100
SEARCH_SUGGEST_LIMIT=8
SEARCH_INDEX_BATCH=200
SEARCH_TYPO_TOLERANCE=true
# [TUNE] Documents whose normalised text each API process keeps for scoring (roughly 2-4 KB each);
# the least recently scored go first. 0 normalises on every query instead.
SEARCH_MEMO_MAX_DOCUMENTS=10000
MEILI_HOST=
MEILI_API_KEY=
STOREFRONT_CACHE_TTL_SECONDS=120
PRODUCT_VIEW_DEDUPE_SECONDS=1800
# [TUNE] How often every API process offers to run the listing reconciler (price windows that
# opened or closed, lost index events). A MySQL lease lets exactly one process run it; 0 turns the
# in-process timer off (then run `npm run listing:reconcile` from cron instead).
LISTING_RECONCILE_INTERVAL_SECONDS=60
# [TUNE] A reconciler run renews its lease between batches; a crashed holder frees it after this.
LISTING_RECONCILE_LEASE_SECONDS=300

# --- cart, wishlist, addresses (Prompt 8) ---------------------------------
# The guest cart cookie is httpOnly and HMAC-signed with this secret.
CART_COOKIE_NAME=cw_cart
CART_COOKIE_SECRET=dev_cart_secret_change_me
CART_GUEST_TTL_DAYS=30
CART_CUSTOMER_TTL_DAYS=180
CART_ABANDON_AFTER_HOURS=6
CART_MAX_LINES=50
CART_MAX_QTY_PER_LINE=20
WISHLIST_MAX_LISTS=10
WISHLIST_MAX_ITEMS=200
ADDRESS_MAX_PER_CUSTOMER=20
RECENTLY_VIEWED_MAX=24

# --- mail ------------------------------------------------------------------
MAIL_DRIVER=log
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@clearwood.local

# --- payments (Prompt 9A) --------------------------------------------------
# Razorpay is ON HOLD. PAYMENT_DRIVER=razorpay is refused at startup unless RAZORPAY_ENABLED=true
# is ALSO set; with it, the key id/secret/webhook secret become mandatory, and SPLIT_ENABLED=true
# additionally requires a second linked account to split with.
# With PAYMENT_DRIVER=mock, production offers NO online payment (cash on delivery only) and refuses
# every provider signature: the mock's signing secrets are public in this repository.
PAYMENT_DRIVER=mock
RAZORPAY_ENABLED=false
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ACCOUNT_PRIMARY=
RAZORPAY_ACCOUNT_SECONDARY=
RAZORPAY_API_BASE=https://api.razorpay.com
PAYMENT_HTTP_TIMEOUT_MS=15000
PAYMENT_MAX_RETRIES=3

# --- checkout & orders (Prompt 9A) -----------------------------------------
# How long a PENDING_PAYMENT order holds stock and a coupon before the sweep releases them.
CHECKOUT_HOLD_MINUTES=20
ORDER_NUMBER_PREFIX=CW
COD_ENABLED=true
COD_MAX_ORDER_PAISE=5000000
COD_FEE_PAISE=0
SPLIT_ENABLED=true
SPLIT_ON_HOLD_DEFAULT=false
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_REPLAY_WINDOW_MINUTES=10
# Only reconciliation may reclaim a lock older than this. Never a user action.
REFUND_LOCK_TIMEOUT_MINUTES=15

# --- fulfilment & shipping (Prompt 9B) -------------------------------------
# `manual` (admin-driven fulfilment) is the default and the only fully verified mode.
# `mock` is a complete offline courier simulator used by the tests.
#
# `shiprocket` is UNVERIFIED and ON HOLD. It was written from published documentation and has
# never made a live call, so its endpoint paths may be wrong. It stays inert - the default driver
# falls back to `manual` with a startup warning, and Shiprocket provider rows are refused - unless
# SHIPROCKET_ENABLED=true AND, in production, SHIPPING_PROVIDER_VERIFIED=true, which you should
# only set after validating every path against a real sandbox account. A missing or unverified
# courier never stops the API from booting.
#
# The default driver also needs SHIPROCKET_EMAIL, SHIPROCKET_PASSWORD and SHIPROCKET_WEBHOOK_TOKEN
# (it falls back to manual without them). Create the API user
# in Shiprocket under Settings > API > Add New API User; the webhook token is the
# `x-api-key` value Shiprocket echoes on every delivery.
# These are BACKEND-ONLY secrets and are never returned by any endpoint.
SHIPPING_DRIVER=manual
SHIPPING_PROVIDER_VERIFIED=false
SHIPROCKET_ENABLED=false
SHIPROCKET_EMAIL=
SHIPROCKET_PASSWORD=
SHIPROCKET_WEBHOOK_TOKEN=
SHIPROCKET_BASE_URL=https://apiv2.shiprocket.in/v1/external
SHIPROCKET_TIMEOUT_MS=20000
SHIPPING_MAX_RETRIES=2
SHIPPING_RETRY_BACKOFF_MS=500
SHIPMENT_NUMBER_PREFIX=CWS
RETURN_NUMBER_PREFIX=CWR
INVOICE_NUMBER_PREFIX=INV
CREDIT_NOTE_PREFIX=CRN
RETURN_WINDOW_DAYS=7
# Customer-initiated returns. OFF by design: returns are an admin-operated process â€” a customer
# asks by phone or WhatsApp and an admin raises it in the console. The customer endpoints exist
# and are tested, but answer 404 until this is true.
FEATURE_CUSTOMER_RETURNS=false
NOTIFICATIONS_ENABLED=true

# --- contact / support -----------------------------------------------------
WHATSAPP_NUMBER=919999999999
SUPPORT_PHONE=+91 99999 99999
SUPPORT_EMAIL=care@clearwood.local

# --- hardening & observability --------------------------------------------
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
LOG_LEVEL=debug

# Adds X-Query-Count / X-Query-Ms and a per-request query log line.
# Blank => on in development only. Ignored entirely in production, whatever it is set to.
DEBUG_QUERY_COUNT=

# --- seeding ---------------------------------------------------------------
# Blank => demo catalog is seeded in development only. Set to false to seed structure alone.
SEED_DEMO=

# The instant every seeded date hangs off, so a database is not a function of when it was made.
SEED_EPOCH=2026-01-01T00:00:00.000Z

# --- CMS and sitemap (Prompt 10A) ------------------------------------------
# [TUNE] Guard rails for the block editor and the public sitemap.
CMS_MAX_BLOCKS_PER_PAGE=60
CMS_MAX_REVISIONS=50
CMS_CACHE_TTL_SECONDS=300
SITEMAP_PAGE_SIZE=5000
# [BOOT in production] Absolute origin the sitemap and canonical URLs are built from.
SITEMAP_BASE_URL=https://www.example.com
# [TUNE] A repeat view from the same session inside this window is not counted twice.
CONTENT_VIEW_DEDUPE_SECONDS=300

# --- cache sizing ----------------------------------------------------------
# [TUNE] Upper bound on the in-memory cache when CACHE_DRIVER=memory.
CACHE_MAX_ITEMS=5000